ARG BASE_IMAGE=pytorch/pytorch:2.10.0-cuda12.8-cudnn9-devel
ARG FINAL_BASE_IMAGE=pytorch/pytorch:2.10.0-cuda12.8-cudnn9-devel

FROM ${BASE_IMAGE} AS build

# 留空 = 不覆盖：wheel 使用 git 派生版本（如 1.3.1.dev2+g<sha>）。
# 发布时传入具体版本号（如 1.3.1）固定 wheel 版本。
ARG VLLM_VERSION_OVERRIDE=

ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    VLLM_SM70_COMPRESSED_TENSORS_TURBOMIND=1 \
    PYTHONUNBUFFERED=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update -y \
    && apt-get install -y --no-install-recommends \
        curl \
        git \
        unzip \
        libibverbs-dev \
        gcc-10 \
        g++-10 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-10 110 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-10

COPY rust-toolchain.toml rust-toolchain.toml
RUN --mount=type=cache,target=/root/.rustup,sharing=locked \
    --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/root/.cargo/git,sharing=locked \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain none \
    && . "$HOME/.cargo/env" \
    && TOOLCHAIN=$(grep '^channel' rust-toolchain.toml | sed 's/.*= *"\(.*\)"/\1/') \
    && (rustup run "${TOOLCHAIN}" rustc --version \
        || rustup toolchain install "${TOOLCHAIN}")
ENV PATH=/root/.cargo/bin:${PATH}

COPY tools/install_protoc.sh /tmp/install_protoc.sh
RUN /tmp/install_protoc.sh

WORKDIR /workspace
COPY . .

# Build the 1cat_vllm wheel from source. Steps follow README
# "Source Build":
#   1. requirements/build/cuda.txt -> cmake, ninja, setuptools(-scm/-rust),
#      wheel, build
#   2. requirements/cuda.txt       -> runtime deps (torch is already in the
#      base image and satisfies the pin, so it is not re-downloaded)
#   3. python -m build --wheel     -> one wheel bundling the CMake CUDA
#      extensions, flash-attention-v100, flash_qla, and vllm-rs
# The sed below is the same cu12 variant fix as docker/Dockerfile.
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,target=/root/.cache/cargo-target,sharing=locked \
    pip install -r requirements/build/cuda.txt \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && sed -i 's/^nvidia-cutlass-dsl\[cu13\]/nvidia-cutlass-dsl/' requirements/cuda.txt \
    && sed -i 's/^humming-kernels\[cu13\]/humming-kernels[cu12]/' requirements/cuda.txt \
    && pip install -r requirements/cuda.txt \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && rm -rf build vllm.egg-info 1cat_vllm.egg-info .deps \
    && env VLLM_VERSION_OVERRIDE=${VLLM_VERSION_OVERRIDE} \
        VLLM_REQUIRE_RUST_FRONTEND=1 \
        TORCH_CUDA_ARCH_LIST="7.0;8.0" \
        FLASH_ATTN_V100_CUDA_ARCH_LIST="7.0" \
        CARGO_BUILD_JOBS=4 \
        CARGO_TARGET_DIR=/root/.cache/cargo-target \
        python3 -m build --wheel --no-isolation --outdir dist-cu128-sm70

FROM ${FINAL_BASE_IMAGE} AS runtime

ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    VLLM_SM70_COMPRESSED_TENSORS_TURBOMIND=1 \
    PYTHONUNBUFFERED=1

COPY --from=build /workspace/dist-cu128-sm70 /tmp/dist-cu128-sm70

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    DEBIAN_FRONTEND=noninteractive \
    apt-get update -y \
    && apt-get install -y --no-install-recommends curl

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir /tmp/dist-cu128-sm70/*.whl
